FROM nginxinc/nginx-unprivileged:1.30.3-alpine@sha256:a0c30a699fa18d7bbdc6faf197742741a1f5e4631066abf18578dc8102b62c5d

USER root
RUN rm -rf /usr/share/nginx/html/* \
    && mkdir -p /usr/share/nginx/html/status/v2 \
    && chown -R 101:101 /usr/share/nginx/html
COPY --chown=101:101 web/ /usr/share/nginx/html/
COPY --chown=101:101 nginx.conf /etc/nginx/nginx.conf
COPY --chown=101:101 security-headers.conf /etc/nginx/security-headers.conf

USER 101:101
