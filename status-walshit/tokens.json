        "colorSpace": "srgb",
        "components": [
          0.09,
          0.09,
          0.075
        ],
        "hex": "#171713"
      }
    },
    "red": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.788,
          0.204,
