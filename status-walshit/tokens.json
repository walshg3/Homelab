{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Shared visual-identity specification that makes status.walshit.com an unmistakable member of the walshit.com family. The global chrome (lockup, header, shell, focus, footer, grain, motion) is canonical and must match walshit.com exactly; the House Report grammar (overall field, ruled ledger, ticket event, filed history, coverage note) is the status-page content layer inside that shared frame. Derived from walshit-landing/hugo/static/styles.css and the walshit-landing Hugo partials, not from the first status prototype.\n",
  "color": {
    "$type": "color",
    "paper": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.949,
          0.918,
          0.851
        ],
        "hex": "#f2ead9"
      }
    },
    "paperSecondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.898,
          0.847,
          0.741
